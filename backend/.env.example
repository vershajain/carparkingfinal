# Copy to .env and edit. Never commit .env.
PORT=4000
NODE_ENV=development
# Local MongoDB. Transactions require a replica set (see README); the app
# falls back to atomic conditional updates when transactions are unavailable.
MONGODB_URI=mongodb://127.0.0.1:27017/os_parking_scheduler
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
# Initial admin created by the seed script (change these)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin

# Integration tests WIPE this database - its name must end with "_test"
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/os_parking_test
